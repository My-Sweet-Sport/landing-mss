---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroDevices from './HeroDevices.astro';
import Icon from './Icon.astro';
import NewsRow from './NewsRow.astro';
import { t, rich, ui, url, routes, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang];
const home = (await getEntry('settings', 'home'))!.data;
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const clients = (await getCollection('clients', (e) => e.data.visible)).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
const facts = home.about.facts ?? [];
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---

<Base lang={lang} altHref={routes.home[other]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{s.eyebrow}</p>
        <h1>{t(home.hero.title, lang)}</h1>
        <p class="lede">{t(home.hero.subtitle, lang)}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#produits">{t(home.hero.primaryCta, lang)}</a>
          {
            home.contact.demoUrl && (
              <a class="btn btn-ghost" href={home.contact.demoUrl} rel="noopener">
                {t(home.hero.secondaryCta, lang)}
              </a>
            )
          }
        </div>
      </div>
      <div class="hero-visual">
        <HeroDevices lang={lang} />
      </div>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="wrap about-grid" data-reveal>
      <h2 id="about-title"><span class="kicker" aria-hidden="true">01</span>{t(home.about.title, lang)}</h2>
      <div>
        <div class="prose about-body" set:html={rich(home.about.body, lang)} />
        {
          facts.length > 0 && (
            <dl class="facts">
              {facts.map((f) => (
                <div>
                  <dt>{t(f.label, lang)}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </section>

  <section id="solutions" class="solutions" aria-labelledby="solutions-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 id="solutions-title"><span class="kicker" aria-hidden="true">02</span>{t(home.solutions.title, lang)}</h2>
        <p>{t(home.solutions.intro, lang)}</p>
      </header>
      <ul class="solution-list">
        {
          home.solutions.items.map((item, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="solution-icon">
                <Icon name={item.icon} />
              </span>
              <h3>{t(item.title, lang)}</h3>
              <p>{t(item.body, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="produits" class="products" aria-labelledby="products-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 id="products-title"><span class="kicker" aria-hidden="true">03</span>{s.productsTitle}</h2>
        <p>{s.productsIntro}</p>
      </header>
      <div class="product-grid">
        {
          products.map(({ data: p }, i) => (
            <article class="product" data-reveal style={`--i:${i}`}>
              <div class="product-top">
                {p.icon && <img src={url(p.icon)} alt="" width="56" height="56" loading="lazy" />}
                <div>
                  <p class="audience">{t(p.audience, lang)}</p>
                  <h3>{p.name}</h3>
                </div>
              </div>
              <p class="tagline">{t(p.tagline, lang)}</p>
              <p class="desc">{t(p.description, lang)}</p>
              {p.features && p.features.length > 0 && (
                <ul class="features">
                  {p.features.map((f) => (
                    <li>{t(f, lang)}</li>
                  ))}
                </ul>
              )}
              <div class="product-actions">
                <a class="btn btn-primary" href={p.url} rel="noopener">
                  {t(p.cta, lang)}
                  <span class="visually-hidden">: {p.name}</span>
                </a>
                {p.appStoreUrl && (
                  <a class="appstore" href={p.appStoreUrl} rel="noopener">
                    <svg viewBox="0 0 384 512" width="20" height="24" aria-hidden="true" fill="currentColor">
                      <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                    </svg>
                    <span class="appstore-text">
                      <small>{s.appStore.small}</small>
                      <strong>{s.appStore.big}</strong>
                    </span>
                    <span class="visually-hidden">: {p.name}</span>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="nouvelles" class="news" aria-labelledby="news-title">
    <div class="wrap">
      <header class="section-head row" data-reveal>
        <h2 id="news-title"><span class="kicker" aria-hidden="true">04</span>{s.newsTitle}</h2>
        <a class="all" href={url(routes.news[lang])}>{s.newsAll}</a>
      </header>
      {
        news.length > 0 ? (
          <ul class="news-list">
            {news.map((n) => (
              <NewsRow entry={n} lang={lang} />
            ))}
          </ul>
        ) : (
          <p class="empty">{s.newsEmpty}</p>
        )
      }
    </div>
  </section>

  {
    clients.length > 0 && (
      <section id="clients" class="clients" aria-labelledby="clients-title">
        <div class="wrap clients-grid">
          <header class="clients-head" data-reveal>
            <h2 id="clients-title"><span class="kicker" aria-hidden="true">05</span>{s.clientsTitle}</h2>
            <p>{s.clientsIntro}</p>
          </header>
          <ul class="logo-grid">
            {clients.map(({ data: c }, i) => {
              const inner = (
                <>
                  <span class="logo-box">
                    {c.logo ? (
                      <img src={url(c.logo)} alt="" loading="lazy" />
                    ) : (
                      <span class="initials" aria-hidden="true">{c.name.slice(0, 2)}</span>
                    )}
                  </span>
                  <span class="client-name">{c.name}</span>
                  {c.url && (
                    <svg class="ext" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  )}
                </>
              );
              return (
                <li data-reveal style={`--i:${i}`}>
                  {c.url ? <a class="tile" href={c.url} rel="noopener">{inner}</a> : <div class="tile">{inner}</div>}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid" data-reveal>
      <div>
        <h2 id="contact-title">{t(home.contact.title, lang)}</h2>
        <p>{t(home.contact.body, lang)}</p>
      </div>
      <div class="actions">
        {
          home.contact.demoUrl && (
            <a class="btn btn-primary" href={home.contact.demoUrl} rel="noopener">
              {s.bookDemo}
            </a>
          )
        }
        {
          home.contact.email && (
            <a class="btn btn-ghost" href={`mailto:${home.contact.email}`}>
              {s.emailUs}
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  section {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .section-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .section-head p {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .section-head.row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .all {
    color: var(--green);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--rule);
  }
  /* Court-line grid fading out from a green glow behind the product mockups */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero::before {
    background:
      linear-gradient(var(--rule) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, var(--rule) 1px, transparent 1px) 0 0 / 64px 64px;
    opacity: 0.45;
    mask-image: radial-gradient(ellipse 70% 80% at 75% 45%, #000 10%, transparent 70%);
  }
  .hero::after {
    background:
      radial-gradient(40rem 28rem at 78% 40%, rgba(34, 210, 75, 0.18), transparent 65%),
      radial-gradient(30rem 24rem at 10% 100%, rgba(80, 78, 140, 0.25), transparent 70%);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: var(--step-4);
    letter-spacing: -0.01em;
    max-width: 14ch;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero-visual {
    justify-self: end;
    width: 100%;
    max-width: 36rem;
  }
  .kicker {
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--green);
  }
  .kicker::after {
    content: '';
    display: inline-block;
    vertical-align: middle;
    width: 2.5rem;
    height: 1px;
    margin-left: 0.75rem;
    background: currentColor;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      justify-self: center;
    }
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem 4rem;
  }
  .about-body {
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    margin: 2.5rem 0 0;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: var(--step-3);
    color: var(--green);
  }
  .facts dt {
    color: var(--muted);
    font-size: var(--step--1);
  }
  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Solutions */
  .solutions {
    background: var(--court-deep);
  }
  .solution-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  /* Never leave a card alone on a row: 4 → 4 cols; 5–6 → rows of 3 (+2 wide) */
  @media (min-width: 1041px) {
    .solution-list:has(> li:nth-child(5)) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .solution-list:has(> li:nth-child(5)) > li {
      grid-column: span 2;
    }
    .solution-list:has(> li:nth-child(5):last-child) > li:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  @media (max-width: 1040px) {
    .solution-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .solution-list > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .solution-list {
      grid-template-columns: 1fr;
    }
  }
  .solution-list li {
    position: relative;
    padding: 1.75rem 1.5rem 1.9rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    border-radius: 16px;
    border: 1px solid var(--rule);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 70%);
    transition: border-color 0.2s, transform 0.25s ease-out, background-color 0.2s;
  }
  .solution-list li:hover {
    border-color: rgba(34, 210, 75, 0.45);
    transform: translateY(-3px);
  }
  .solution-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    background: var(--green-soft);
    color: var(--green);
  }
  .solution-list h3 {
    font-size: var(--step-1);
    font-stretch: 90%;
  }
  .solution-list p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* Products */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
  }
  .product {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background:
      radial-gradient(28rem 16rem at 100% 0%, rgba(34, 210, 75, 0.12), transparent 70%),
      var(--court-raised);
    border-radius: 20px;
    border: 1px solid var(--rule);
    transition: border-color 0.2s, transform 0.25s ease-out, box-shadow 0.25s;
  }
  /* Green accent line along the top edge */
  .product::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--green), transparent 80%);
  }
  .product:hover {
    border-color: rgba(34, 210, 75, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 24px 60px -30px rgba(34, 210, 75, 0.45);
  }
  .product-top {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .product-top img {
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }
  .audience {
    color: var(--green);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .product h3 {
    font-size: var(--step-2);
  }
  .tagline {
    font-family: var(--font-display);
    font-stretch: 85%;
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .desc {
    color: var(--muted);
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .features li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.98rem;
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.42em;
    width: 0.7rem;
    height: 0.7rem;
    border: 2.5px solid var(--green);
    border-radius: 50%;
  }
  .product-actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  /* App Store badge look: black pill, Apple glyph, two-line label */
  .appstore {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.4rem 1.1rem 0.4rem 0.95rem;
    border-radius: 12px;
    background: #000;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .appstore:hover {
    border-color: #fff;
    background: #111;
  }
  .appstore-text {
    display: grid;
    line-height: 1.1;
  }
  .appstore small {
    font-size: 0.7rem;
    font-weight: 500;
  }
  .appstore strong {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* News */
  .news {
    border-top: 1px solid var(--rule);
  }
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty {
    color: var(--muted);
  }

  /* Clients: stays on the dark theme; logos sit in tiles so any colour reads */
  .clients {
    position: relative;
    background:
      radial-gradient(36rem 20rem at 85% 50%, rgba(34, 210, 75, 0.08), transparent 70%),
      var(--court-deep);
    border-top: 1px solid var(--rule);
  }
  .clients-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2.5rem 4rem;
    align-items: center;
  }
  .clients-head p {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 28rem;
  }
  .logo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }
  .tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-height: 6.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--rule);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015));
    text-decoration: none;
    transition: border-color 0.2s, transform 0.25s ease-out;
  }
  a.tile:hover {
    border-color: rgba(34, 210, 75, 0.45);
    transform: translateY(-3px);
  }
  .logo-box {
    flex: none;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
  }
  .logo-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    background: var(--green-soft);
    color: var(--green);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
  }
  .client-name {
    font-family: var(--font-display);
    font-stretch: 85%;
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .ext {
    margin-left: auto;
    align-self: flex-start;
    color: var(--muted);
    transition: color 0.2s, translate 0.2s;
  }
  a.tile:hover .ext {
    color: var(--green);
    translate: 2px -2px;
  }
  @media (max-width: 760px) {
    .clients-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Contact */
  .contact {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--green);
    color: var(--green-ink);
  }
  /* Faint court lines: half court with attack line */
  .contact::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -10rem;
    width: 34rem;
    height: 17rem;
    translate: 0 -50%;
    border: 2px solid rgba(6, 33, 15, 0.1);
    background: linear-gradient(90deg, transparent calc(33% - 1px), rgba(6, 33, 15, 0.1) calc(33% - 1px) calc(33% + 1px), transparent calc(33% + 1px));
  }
  @media (max-width: 1100px) {
    .contact::before { display: none; }
  }
  .contact-grid {
    display: flex;
    flex-wrap: wrap;
