---
// Half a volleyball court seen from above, net at the top, with the six
// rotation zones. A play is drawn on it once, on page load: the attack comes
// over the net and the called zone lights up. This is the page's one moment
// of motion, and it echoes how MySweetSport Go works.
interface Props {
  label: string;
}
const { label } = Astro.props;
// Court: x 20→380, y 70→430 (9 m × 9 m, 40 px per metre). Attack line at 3 m.
const zones = [
  { n: 4, x: 20, y: 70, w: 120, h: 120 },
  { n: 3, x: 140, y: 70, w: 120, h: 120 },
  { n: 2, x: 260, y: 70, w: 120, h: 120 },
  { n: 5, x: 20, y: 190, w: 120, h: 240 },
  { n: 6, x: 140, y: 190, w: 120, h: 240 },
  { n: 1, x: 260, y: 190, w: 120, h: 240 },
];
---

<svg class="court" viewBox="0 0 400 450" role="img" aria-label={label}>
  <rect class="floor" x="20" y="70" width="360" height="360" rx="2" />
  <rect class="called" x="20" y="190" width="120" height="240" />
  {
    zones.map((z) => (
      <text class="zone-n" x={z.x + 14} y={z.y + 12} dominant-baseline="hanging">
        {z.n}
      </text>
    ))
  }
  <g class="lines">
    <rect x="20" y="70" width="360" height="360" />
    <line x1="20" y1="190" x2="380" y2="190" />
    <line class="zone-sep" x1="140" y1="70" x2="140" y2="430" />
    <line class="zone-sep" x1="260" y1="70" x2="260" y2="430" />
  </g>
  <g class="net">
    <line x1="4" y1="70" x2="396" y2="70" />
    <circle cx="4" cy="70" r="4" />
    <circle cx="396" cy="70" r="4" />
  </g>

  <!-- Defenders -->
  <g class="players">
    <circle cx="200" cy="330" r="13" />
    <circle cx="320" cy="300" r="13" />
    <circle cx="200" cy="130" r="13" />
  </g>

  <!-- The attack: from above the net into zone 5 -->
  <circle class="ball" cx="300" cy="28" r="11" />
  <path class="shot" d="M300 40 C 250 110, 150 200, 86 336" pathLength="1" />
  <path class="head" d="M72 318 L84 342 L104 325" pathLength="1" />
  <g class="mark">
    <line x1="64" y1="352" x2="100" y2="388" />
    <line x1="100" y1="352" x2="64" y2="388" />
  </g>
</svg>

<style>
  .court {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .floor {
    fill: var(--court-raised);
  }
  .called {
    fill: var(--green-soft);
    opacity: 0;
    animation: show 0.5s ease-out 1.6s forwards;
  }
  .zone-n {
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: 30px;
    fill: rgba(244, 245, 247, 0.32);
  }
  .lines rect,
  .lines line {
    fill: none;
    stroke: rgba(244, 245, 247, 0.75);
    stroke-width: 2.5;
  }
  .lines .zone-sep {
    stroke: rgba(244, 245, 247, 0.16);
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }
  .net line {
    stroke: var(--line);
    stroke-width: 5;
  }
  .net circle {
    fill: var(--line);
  }
  .players circle {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
  }
  .ball {
    fill: var(--green);
  }
  .shot,
  .head {
    fill: none;
    stroke: var(--green);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .shot {
    animation: draw 0.9s cubic-bezier(0.5, 0, 0.3, 1) 0.4s forwards;
  }
  .head {
    animation: draw 0.25s ease-out 1.25s forwards;
  }
  .mark line {
    stroke: var(--green);
    stroke-width: 7;
    stroke-linecap: round;
    opacity: 0;
    animation: show 0.3s ease-out 1.45s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
</style>
